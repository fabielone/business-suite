# Demo ignores these values and uses fictional, ephemeral data.
# Real API and migrations require an explicitly loaded environment.
# Do not use this placeholder password on any host.
SUITE_DB_PASSWORD=replace-with-a-local-secret
# Runtime URL: use a separately provisioned restricted login (see db/README.md).
DATABASE_URL=postgresql://suite_api_login:replace-with-a-runtime-secret@127.0.0.1:5439/business_suite
API_HOST=127.0.0.1
API_PORT=4310
API_ALLOWED_ORIGINS=http://127.0.0.1:5178
AUTH_ISSUER=https://your-auth-host.example/auth/v1
AUTH_AUDIENCE=authenticated
# Choose one verification mechanism supported by your actual auth issuer.
AUTH_JWKS_URL=https://your-auth-host.example/auth/v1/.well-known/jwks.json
# AUTH_JWT_SECRET=server-only-shared-verification-secret
